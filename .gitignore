# Project-specific
data/
!data/**/.gitkeep
# Reproducibility: release the CANONICAL base SFT dataset (Paper 1 A1 trains on
# this; ablation subsets are derivable via setup_paper_ablation_data.py). Other
# data/ subdirs stay ignored (large + regenerable via scripts/run_generation.py).
!data/sft_filtered/
!data/sft_filtered/**
checkpoints/
wandb/
*.ckpt
*.pt
*.safetensors
*.bin
runs/
outputs/
# Reproducibility: release the score JSONs (the numbers behind every paper table).
# Model weights (*.safetensors/*.bin above) remain ignored.
!outputs/**/score/
!outputs/**/score/**/*.json
logs/

# Offline-install bundle (pip wheels + HF model snapshots + GGUFs).
# Generated by scripts/setup_offline.py on a connected machine and then
# zipped + copied to the offline target — never committed.
vendor/
